import duckdb
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.metrics import silhouette_score

try:
    import seaborn as sns
    sns.set_theme(style="whitegrid")
except ImportError:
    plt.style.use('default')

# 1. Conexión a DuckDB en memoria y semilla determinista
con = duckdb.connect(database=':memory:')
con.execute("SELECT setseed(0.42);")

# 2. Simulación de telemetría de 150 vehículos de flotilla (3 grupos latentes)
con.execute("""
CREATE TABLE telemetria_flotillas AS
WITH base AS (
    SELECT
        vehiculo_id,
        CASE
            WHEN vehiculo_id <= 50 THEN 1  -- Perfil latente urbano eficiente (bajo km, bajo ralentí)
            WHEN vehiculo_id <= 100 THEN 2 -- Perfil latente foráneo carretera (alto km, bajo ralentí)
            ELSE 3                         -- Perfil latente reparto con congestión (medio km, alto ralentí)
        END AS grupo_oculto
    FROM generate_series(1, 150) AS t(vehiculo_id)
)
SELECT
    vehiculo_id,
    ROUND(CASE
        WHEN grupo_oculto = 1 THEN 50 + (random() * 60)    -- 50 a 110 km
        WHEN grupo_oculto = 2 THEN 240 + (random() * 110)  -- 240 a 350 km
        ELSE 75 + (random() * 70)                          -- 75 a 145 km
    END, 1) AS km_recorridos_dia,
    ROUND(CASE
        WHEN grupo_oculto = 1 THEN 0.8 + (random() * 1.2)  -- 0.8 a 2.0 hrs ralentí
        WHEN grupo_oculto = 2 THEN 1.0 + (random() * 1.5)  -- 1.0 a 2.5 hrs ralentí
        ELSE 3.8 + (random() * 2.2)                        -- 3.8 a 6.0 hrs ralentí
    END, 2) AS horas_ralenti_dia
FROM base;
""")

# Extraer datos a DataFrame
df = con.execute("SELECT * FROM telemetria_flotillas").df()
print(f"Registros de flotilla cargados: {len(df)}")
print(df.head())

# 3. Escalado de variables con StandardScaler
scaler = StandardScaler()
X = scaler.fit_transform(df[['km_recorridos_dia', 'horas_ralenti_dia']])

# 4. Evaluación de k (Inercia y Coeficiente de Silueta)
print("\n--- Evaluación de k ---")
for k in range(2, 7):
    km = KMeans(n_clusters=k, random_state=42, n_init=10)
    labels = km.fit_predict(X)
    sil = silhouette_score(X, labels)
    print(f"k = {k} | Inercia = {km.inertia_:.2f} | Silueta = {sil:.3f}")

# 5. Modelo final con k = 3
modelo_final = KMeans(n_clusters=3, random_state=42, n_init=10)
df['cluster'] = modelo_final.fit_predict(X)
centroides = scaler.inverse_transform(modelo_final.cluster_centers_)
print("\nCentroides reales (km_recorridos_dia, horas_ralenti_dia):")
for i, c in enumerate(centroides):
    print(f"Clúster {i}: Distancia = {c[0]:.1f} km, Ralentí = {c[1]:.2f} hrs")
